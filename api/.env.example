# App
CLAUSE_APP_NAME=Clause
CLAUSE_DATA_PATH=data/shop_handbook.pdf

# Chat
CLAUSE_CHAT_PROVIDER=ollama
CLAUSE_CHAT_MODEL=qwen3.5:0.8b
CLAUSE_TEMPERATURE=0.1

# Embeddings
CLAUSE_EMBED_PROVIDER=ollama
CLAUSE_EMBED_MODEL=nomic-embed-text:latest
CLAUSE_EMBED_DIM=768

# Indexing
CLAUSE_CHUNK_SIZE=600
CLAUSE_CHUNK_OVERLAP=100

# Qdrant
CLAUSE_COLLECTION_NAME=shop_handbook
CLAUSE_QDRANT_DATA=./vector_stores

# Retrieval
CLAUSE_TOP_K=3
CLAUSE_SCORE_THRESHOLD=0
