# App
RAG_APP_NAME=Clause
RAG_DATA_PATH=data/shop_handbook.pdf

# Chat
RAG_CHAT_PROVIDER=ollama
RAG_CHAT_MODEL=gemma3:1b
RAG_TEMPERATURE=0.1

# Embeddings
RAG_EMBED_PROVIDER=ollama
RAG_EMBED_MODEL=nomic-embed-text:latest
RAG_EMBED_DIM=768

# Indexing
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100

# Qdrant
RAG_COLLECTION_NAME=shop_handbook
RAG_QDRANT_DATA=./qdrant_data

# Retrieval
RAG_TOP_K=33
RAG_SCORE_THRESHOLD=0.5

# Prompts
RAG_SYSTEM=You are a helpful AI clause shop assistant!